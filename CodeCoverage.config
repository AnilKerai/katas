<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for the Microsoft.Testing.Extensions.CodeCoverage extension (dotnet test, coverage option).
     Each kata keeps its code and its tests in one assembly, so the test assembly must be included;
     the extension leaves it out by default. -->
<Configuration>
  <IncludeTestAssembly>True</IncludeTestAssembly>
</Configuration>
